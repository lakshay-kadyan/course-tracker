# Copy to .env.local and fill in. NEVER commit real values. Server-only: do not prefix with NEXT_PUBLIC_.

# OpenAI: lecture speech-to-text
OPENAI_API_KEY=your-openai-api-key
# Optional. Default: whisper-1 (others such as gpt-4o-transcribe may be available to your account)
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Google Gemini: transcript and syllabus analysis
GEMINI_API_KEY=your-gemini-api-key
# Optional. Default: gemini-2.5-flash. Must be a model available to your key.
GEMINI_MODEL=gemini-2.5-flash

# Shared secret required by /api/ai/* (Authorization: Bearer <token>). Without it the endpoints stay disabled.
# Generate one:  openssl rand -base64 32
# Temporary until Supabase Auth replaces it with real session/role checks.
AI_ACCESS_TOKEN=generate-a-long-random-string

# Optional timeouts (milliseconds)
# OPENAI_TIMEOUT_MS=120000
# GEMINI_TIMEOUT_MS=60000

# Supabase (public values only; safe for the browser). Without these the app runs as the local demo.
# Find them in Supabase > Project Settings > API (or the Connect panel, framework: Next.js).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# NEVER put the service-role / secret key in any NEXT_PUBLIC_ variable or in chat.
